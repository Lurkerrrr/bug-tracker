# Environment
ENV=development
PORT=5000

# Database (Docker service network)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres

# JWT
# Generate a secure token with:
# PowerShell: -join ((1..128) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
# bash:       openssl rand -hex 64
JWT_TOKEN=replace-with-secure-random-128-char-hex-string
JWT_EXPIRATION=15m
JWT_EXPIRATION_EXCHANGE=7d